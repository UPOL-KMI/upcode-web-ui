{
  "name": "recodex-web-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deps:check": "pnpm outdated || true; pnpm audit --audit-level moderate || true",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "generate:api-types": "openapi-typescript openapi/core-api.yaml -o lib/api/core-api.generated.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:route-messages": "tsx scripts/route-messages.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@shikijs/rehype": "^4.4.3",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "cmdk": "^1.1.1",
    "github-slugger": "2.0.0",
    "katex": "^0.18.4",
    "next": "16.3.1",
    "next-intl": "4.13.7",
    "next-themes": "0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "0.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "4.3.3",
    "unified": "^11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  }
}
